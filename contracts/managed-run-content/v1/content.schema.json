{
  "$defs": {
    "FileFreshness": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "site-agent",
          "title": "Source",
          "type": "string"
        },
        "queried_at": {
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "title": "Queried At",
          "type": "string"
        }
      },
      "required": [
        "source",
        "queried_at"
      ],
      "title": "FileFreshness",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "compute.run-artifact-content/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_key": {
      "maxLength": 128,
      "minLength": 9,
      "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Workspace Key",
      "type": "string"
    },
    "site_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Site Id",
      "type": "string"
    },
    "run_ref": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+-]*$",
      "title": "Run Ref",
      "type": "string"
    },
    "artifact_ref": {
      "pattern": "^artifact-[0-9a-f]{40}$",
      "title": "Artifact Ref",
      "type": "string"
    },
    "relative_path": {
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$",
      "title": "Relative Path",
      "type": "string"
    },
    "status": {
      "enum": [
        "available",
        "missing",
        "unsupported",
        "changed"
      ],
      "title": "Status",
      "type": "string"
    },
    "content": {
      "maxLength": 65536,
      "title": "Content",
      "type": "string"
    },
    "offset": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Offset",
      "type": "integer"
    },
    "next_offset": {
      "maximum": 9223372036854775807,
      "minimum": 0,
      "title": "Next Offset",
      "type": "integer"
    },
    "bytes_read": {
      "maximum": 65536,
      "minimum": 0,
      "title": "Bytes Read",
      "type": "integer"
    },
    "complete": {
      "title": "Complete",
      "type": "boolean"
    },
    "version": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Version"
    },
    "size_bytes": {
      "anyOf": [
        {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Size Bytes"
    },
    "modified_at_ns": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Modified At Ns"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 84,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Cursor"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 84,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    },
    "observed_at": {
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "title": "Observed At",
      "type": "string"
    },
    "freshness": {
      "$ref": "#/$defs/FileFreshness"
    }
  },
  "required": [
    "schema_version",
    "workspace_key",
    "site_id",
    "run_ref",
    "artifact_ref",
    "relative_path",
    "status",
    "content",
    "offset",
    "next_offset",
    "bytes_read",
    "complete",
    "version",
    "size_bytes",
    "modified_at_ns",
    "cursor",
    "next_cursor",
    "observed_at",
    "freshness"
  ],
  "title": "ManagedRunArtifactContentOut",
  "type": "object"
}
