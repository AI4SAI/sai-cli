{
  "$defs": {
    "InvitationItem": {
      "properties": {
        "invitation_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Invitation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "pending",
            "accepted",
            "expired",
            "revoked"
          ],
          "title": "Status",
          "type": "string"
        },
        "target_kind": {
          "enum": [
            "organization",
            "project",
            "directory"
          ],
          "title": "Target Kind",
          "type": "string"
        },
        "target_label": {
          "maxLength": 1200,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Target Label",
          "type": "string"
        },
        "role": {
          "enum": [
            "member",
            "read",
            "write",
            "admin"
          ],
          "title": "Role",
          "type": "string"
        },
        "site_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "site_label": {
          "maxLength": 1200,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
          "title": "Site Label",
          "type": "string"
        },
        "directory_site_labels": {
          "items": {
            "maxLength": 1200,
            "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]*$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Directory Site Labels",
          "type": "array"
        },
        "relationship_scope": {
          "enum": [
            "global",
            "directory"
          ],
          "title": "Relationship Scope",
          "type": "string"
        },
        "membership_valid_from": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Membership Valid From"
        },
        "membership_expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Membership Expires At"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "accepted_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Accepted At"
        },
        "has_compute_resources": {
          "title": "Has Compute Resources",
          "type": "boolean"
        },
        "uses_project_budget": {
          "title": "Uses Project Budget",
          "type": "boolean"
        }
      },
      "required": [
        "invitation_id",
        "status",
        "target_kind",
        "target_label",
        "role",
        "site_id",
        "site_label",
        "directory_site_labels",
        "relationship_scope",
        "membership_valid_from",
        "membership_expires_at",
        "expires_at",
        "accepted_at",
        "has_compute_resources",
        "uses_project_budget"
      ],
      "title": "InvitationItem",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "collaboration.invitations/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/InvitationItem"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "count": {
      "maximum": 100,
      "minimum": 0,
      "title": "Count",
      "type": "integer"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "schema_version",
    "items",
    "count",
    "has_more",
    "next_cursor"
  ],
  "title": "InvitationPageOut",
  "type": "object"
}
