{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portal-resolved current job workspace navigation",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "token": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$", "not": {"pattern": "[\\x00-\\x1f\\x7f-\\x9f]"}},
    "timestamp": {"type": "string", "maxLength": 64, "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$", "not": {"pattern": "[\\x00-\\x1f\\x7f-\\x9f]"}}
  },
  "properties": {
    "schema_version": {"const": "jobs.web-context/v1"},
    "workspace_key": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^(personal|org|project):[A-Za-z0-9][A-Za-z0-9._:-]*$", "not": {"pattern": "[\\x00-\\x1f\\x7f-\\x9f]"}},
    "site_id": {"$ref": "#/$defs/token"},
    "cluster_id": {"$ref": "#/$defs/token"},
    "scope_type": {"enum": ["personal_account", "org_account", "project_account"]},
    "slurm_account_id": {"$ref": "#/$defs/token"},
    "job_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[0-9]+(?:_[0-9]+)?$", "not": {"pattern": "[^0-9_]"}},
    "observed_at": {"$ref": "#/$defs/timestamp"},
    "submit_time": {"anyOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]},
    "restart_count": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 65535}, {"type": "null"}]}
  },
  "required": ["schema_version", "workspace_key", "site_id", "cluster_id", "scope_type", "slurm_account_id", "job_id", "observed_at", "submit_time", "restart_count"],
  "allOf": [
    {"if": {"properties": {"scope_type": {"const": "personal_account"}}}, "then": {"properties": {"workspace_key": {"pattern": "^personal:"}}}},
    {"if": {"properties": {"scope_type": {"const": "org_account"}}}, "then": {"properties": {"workspace_key": {"pattern": "^org:"}}}},
    {"if": {"properties": {"scope_type": {"const": "project_account"}}}, "then": {"properties": {"workspace_key": {"pattern": "^project:"}}}}
  ]
}
