        "array_task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpus_per_node": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "mem_per_unit": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "qos": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_or_nodelist": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_wait_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "slots": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "slurm_account": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "slurm_user": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "date-time",
              "maxLength": 64,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "maxLength": 32,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "state_label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "submit_time": {
          "anyOf": [
            {
              "format": "date-time",
              "maxLength": 64,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_link": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 64,
              "maxLength": 64,
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 36,
              "maxLength": 36,
              "pattern": "^[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "array_task_id",
        "name",
        "slurm_user",
        "slurm_account",
        "state",
        "state_label",
        "priority",
        "submit_time",
        "start_time",
        "elapsed_seconds",
        "run_wait_seconds",
        "partition",
        "qos",
        "nodes",
        "slots",
        "gpus_per_node",
        "mem_per_unit",
        "reason_or_nodelist"
      ],
      "type": "object"
    },
    "node": {
      "additionalProperties": true,
      "properties": {
        "cpus": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "memory_mib": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        "gres": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/gres"
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "cpus",
        "memory_mib",
        "gres"
      ],
      "type": "object"
    },
    "gres": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "type",
        "count",
        "indices"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$",
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "indices": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          ]
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "allocation": {
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "allocated"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_allocated"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "maxItems": 0,
                "type": "array"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "nodes": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "nodes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/node"
              },
              "maxItems": 4096,
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "allocated",
            "not_allocated",
            "unavailable"
          ]
        }
      },
      "required": [
        "status",
        "nodes"
      ],
      "type": "object"
    },
    "cluster_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
      "type": "string"
    },
    "etag": {
      "maxLength": 64,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "freshness": {
      "additionalProperties": true,
      "properties": {
        "age_seconds": {
          "minimum": 0,
          "type": "integer"
        },
        "observed_at": {
          "format": "date-time",
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        "source": {
          "const": "scontrol"
        },
        "stale": {
          "type": "boolean"
        },
        "ttl_seconds": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "source",
        "observed_at",
        "ttl_seconds",
        "age_seconds",
        "stale"
      ],
      "type": "object"
    },
    "job": {
      "$ref": "#/$defs/job"
    },
    "restart_count": {
      "anyOf": [
        {
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "scheduler_states": {
      "items": {
        "maxLength": 32,
        "minLength": 1,
        "not": {
          "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
        },
        "pattern": "^[A-Z][A-Z0-9_]{0,31}$",
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "jobs.allocation/v2"
    },
    "scope_type": {
      "enum": [
        "self",
        "personal_account",
        "org_account",
        "project_account"
      ]
    },
    "site_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      },
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
      "type": "string"
    },
    "subject": {
      "additionalProperties": true,
      "properties": {
        "slurm_account": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "slurm_user": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "slurm_user",
        "slurm_account"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "site_id",
    "cluster_id",
    "scope_type",
    "subject",
    "freshness",
    "etag",
    "job",
    "restart_count",
    "scheduler_states",
    "allocation"
  ],
  "title": "Authorized native job allocation snapshot",
  "type": "object"
}
