{
  "$defs": {
    "DefaultAccountProjection": {
      "properties": {
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "site_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "task_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "site_id",
        "task_id",
        "generation"
      ],
      "title": "DefaultAccountProjection",
      "type": "object"
    }
  },
  "properties": {
    "default_account_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default Account Id"
    },
    "previous_account_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Account Id"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 8,
      "pattern": "^[A-Za-z0-9_.:-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "account.default-change/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "user",
      "title": "Scope",
      "type": "string"
    },
    "site_projections": {
      "items": {
        "$ref": "#/$defs/DefaultAccountProjection"
      },
      "maxItems": 64,
      "title": "Site Projections",
      "type": "array"
    },
    "state": {
      "const": "accepted",
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "request_id",
    "state",
    "previous_account_id",
    "default_account_id",
    "site_projections"
  ],
  "title": "DefaultAccountChangeOut",
  "type": "object"
}
