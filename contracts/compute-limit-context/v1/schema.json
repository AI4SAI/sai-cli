{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current native association limits and verified SAI sources",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "observed_at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 513,
      "items": {
        "$ref": "#/$defs/constraint"
      }
    }
  },
  "required": [
    "observed_at",
    "constraints"
  ],
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "service_level",
            "grant",
            "reservation",
            "org_admin",
            "project_pi",
            "hard_clamp",
            "member_limit",
            "risk_control"
          ]
        },
        "service_level_code": {
          "type": "string",
          "enum": [
            "personal_unverified",
            "personal_standard",
            "registration_trial",
            "personal_advanced",
            "org_standard",
            "standard",
            "plus",
            "pro",
            "ultra"
          ]
        },
        "grant_kind": {
          "type": "string",
          "enum": [
            "baseline",
            "assurance",
            "contract",
            "subscription",
            "trial",
            "mis"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "required": [
              "service_level_code"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "service_level",
                  "grant"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "grant_kind"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "const": "grant"
              }
            }
          }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "account": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "scope": {
          "type": "string",
          "enum": [
            "account",
            "member"
          ]
        },
        "field": {
          "type": "string",
          "enum": [
            "billing_tres_limit",
            "max_submit_jobs"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 20,
          "pattern": "^(?:0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-2]|18446744073709551613)$",
          "not": {
            "pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
          }
        },
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "required": [
        "account",
        "scope",
        "field",
        "value",
        "sources"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "max_submit_jobs"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "pattern": "^(?:0|[1-9][0-9]{0,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]{1}|429496729[0-2]|4294967293)$"
              }
            }
          }
        }
      ]
    },
    "job_binding": {
      "if": {
        "required": [
          "limit_context"
        ],
        "properties": {
          "limit_context": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "PD"
          },
          "reason_or_nodelist": {
            "enum": [
              "AssocGrpBilling",
              "AssocMaxSubmitJobLimit"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reason_or_nodelist": {
                  "const": "AssocGrpBilling"
                }
              }
            },
            "then": {
              "properties": {
                "limit_context": {
                  "properties": {
                    "constraints": {
                      "items": {
                        "properties": {
                          "field": {
                            "const": "billing_tres_limit"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reason_or_nodelist": {
                  "const": "AssocMaxSubmitJobLimit"
                }
              }
            },
            "then": {
              "properties": {
                "limit_context": {
                  "properties": {
                    "constraints": {
                      "items": {
                        "properties": {
                          "field": {
                            "const": "max_submit_jobs"
                          }
                        }
                      },
                      "maxItems": 1
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
