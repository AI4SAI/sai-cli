{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized native Lustre quota observations",
  "type": "object",
  "required": [
    "schema_version",
    "site_id",
    "workspace_key",
    "source",
    "coverage",
    "as_of",
    "etag",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": "storage.native-quota/v1"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "workspace_key": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^(personal|org|project):[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "source": {
      "const": "lustre_quota"
    },
    "coverage": {
      "const": "authorized_quota_subjects"
    },
    "as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
    },
    "etag": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "quota_ref",
          "allocation_ref",
          "mount_id",
          "kind",
          "label",
          "observed_at",
          "used_bytes",
          "used_inodes",
          "block_soft_bytes",
          "block_hard_bytes",
          "inode_soft",
          "inode_hard"
        ],
        "properties": {
          "quota_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
            "maxLength": 128
          },
          "allocation_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
            "maxLength": 128
          },
          "mount_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
            "maxLength": 128
          },
          "kind": {
            "enum": [
              "home",
              "organization_shared",
              "directory",
              "project"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$"
          },
          "used_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          },
          "used_inodes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          },
          "block_soft_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          },
          "block_hard_bytes": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          },
          "inode_soft": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          },
          "inode_hard": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,22})$",
            "maxLength": 23
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
