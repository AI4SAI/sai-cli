{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline installed CLI operation description",
  "type": "object",
  "required": [
    "schema_version",
    "client_version",
    "authorization_checked",
    "path",
    "detailed",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "cli.describe/v1"
    },
    "client_version": {
      "type": "string"
    },
    "authorization_checked": {
      "const": false
    },
    "path": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "detailed": {
      "type": "boolean"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "command",
        "summary",
        "source",
        "effect",
        "interaction"
      ],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string"
        },
        "source": {
          "enum": [
            "client",
            "native",
            "portal",
            "site_gateway",
            "configured_site_read",
            "identity",
            "identity_and_portal",
            "mixed"
          ]
        },
        "effect": {
          "enum": [
            "introspection",
            "read",
            "local_file_write",
            "business_write",
            "session_write"
          ]
        },
        "interaction": {
          "enum": [
            "none",
            "terminal",
            "browser_consent"
          ]
        },
        "required_scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "site_required": {
          "type": "boolean"
        },
        "cluster_option": {
          "type": "boolean"
        },
        "native_executables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readback": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conditional_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "when"
            ],
            "properties": {
              "when": {
                "type": "string"
              },
              "effect": {
                "enum": ["business_write"]
              },
              "scopes": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "executables": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter"
          }
        },
        "exclusive_parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "parameters",
              "required"
            ],
            "properties": {
              "parameters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "site_option": {
          "type": "boolean"
        }
      }
    },
    "parameter": {
      "type": "object",
      "required": [
        "name",
        "flags",
        "type",
        "arity",
        "required",
        "description"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean"
          ]
        },
        "arity": {
          "enum": [
            0,
            1,
            "?",
            "*",
            "+"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "choices": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "detailed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "operations": {
            "maxItems": 1,
            "items": {
              "required": [
                "required_scopes",
                "site_required",
                "cluster_option",
                "native_executables",
                "conditional_requirements",
                "notes",
                "readback",
                "parameters",
                "exclusive_parameters",
                "site_option"
              ]
            }
          }
        }
      }
    }
  ]
}
