{
  "$defs": {
    "DefaultAccountChoice": {
      "properties": {
        "id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "personal",
            "org",
            "project"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,63}$",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "kind"
      ],
      "title": "DefaultAccountChoice",
      "type": "object"
    },
    "DefaultAccountDelivery": {
      "properties": {
        "applied_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Applied At"
        },
        "cluster_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Cluster Id",
          "type": "string"
        },
        "generation": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation"
        },
        "site_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "not_requested",
            "pending",
            "applied",
            "failed",
            "unavailable"
          ],
          "title": "State",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Task Id"
        }
      },
      "required": [
        "site_id",
        "cluster_id",
        "state",
        "task_id",
        "generation",
        "applied_at"
      ],
      "title": "DefaultAccountDelivery",
      "type": "object"
    }
  },
  "properties": {
    "choices": {
      "items": {
        "$ref": "#/$defs/DefaultAccountChoice"
      },
      "maxItems": 500,
      "title": "Choices",
      "type": "array"
    },
    "cluster_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Cluster Id",
      "type": "string"
    },
    "default_account_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Default Account Id"
    },
    "deliveries": {
      "items": {
        "$ref": "#/$defs/DefaultAccountDelivery"
      },
      "maxItems": 64,
      "title": "Deliveries",
      "type": "array"
    },
    "effective_account_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Account Id"
    },
    "schema_version": {
      "const": "account.defaults/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "const": "user",
      "title": "Scope",
      "type": "string"
    },
    "site_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Site Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "default_account_id",
    "site_id",
    "cluster_id",
    "effective_account_id",
    "choices",
    "deliveries"
  ],
  "title": "DefaultAccountOut",
  "type": "object"
}
