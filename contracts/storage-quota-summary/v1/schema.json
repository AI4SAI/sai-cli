{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Observation-backed quota facts without paths or mutation controls.",
  "properties": {
    "effective_total_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.]"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Effective Total Tib"
    },
    "inode_hard_limit": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inode Hard Limit"
    },
    "inode_soft_limit": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inode Soft Limit"
    },
    "mount_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x20\\x7f-\\x9f]"
          },
          "pattern": "^[^\\x00-\\x20\\x7f-\\x9f]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mount Id"
    },
    "observed_at": {
      "anyOf": [
        {
          "format": "date-time",
          "maxLength": 27,
          "minLength": 20,
          "not": {
            "pattern": "[\\x00-\\x20\\x7f-\\x9f]"
          },
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed At"
    },
    "observed_hard_limit_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.]"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Hard Limit Tib"
    },
    "observed_soft_limit_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.]"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Observed Soft Limit Tib"
    },
    "quota_updated_at": {
      "anyOf": [
        {
          "format": "date-time",
          "maxLength": 27,
          "minLength": 20,
          "not": {
            "pattern": "[\\x00-\\x20\\x7f-\\x9f]"
          },
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Quota Updated At"
    },
    "remaining_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.\\-]"
          },
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Remaining Tib"
    },
    "schema_version": {
      "const": "storage.quota-summary/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "site_id": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00-\\x20\\x7f-\\x9f]"
      },
      "pattern": "^[^\\x00-\\x20\\x7f-\\x9f]+$",
      "title": "Site Id",
      "type": "string"
    },
    "source": {
      "const": "portal_quota_observation",
      "title": "Source",
      "type": "string"
    },
    "state": {
      "enum": [
        "ready",
        "pending",
        "failed",
        "drift",
        "unavailable"
      ],
      "title": "State",
      "type": "string"
    },
    "target_total_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.]"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Target Total Tib"
    },
    "used_inodes": {
      "anyOf": [
        {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Used Inodes"
    },
    "used_tib": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "pattern": "[^0-9.]"
          },
          "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Used Tib"
    },
    "workspace_key": {
      "maxLength": 128,
      "minLength": 1,
      "not": {
        "pattern": "[\\x00-\\x20\\x7f-\\x9f]"
      },
      "pattern": "^[^\\x00-\\x20\\x7f-\\x9f]+$",
      "title": "Workspace Key",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "workspace_key",
    "site_id",
    "mount_id",
    "state",
    "source",
    "target_total_tib",
    "effective_total_tib",
    "used_tib",
    "remaining_tib",
    "observed_soft_limit_tib",
    "observed_hard_limit_tib",
    "used_inodes",
    "inode_soft_limit",
    "inode_hard_limit",
    "observed_at",
    "quota_updated_at"
  ],
  "title": "AccountStorageQuotaSummaryCliOut",
  "type": "object"
}
