{
  "$defs": {
    "ProjectComputeRef": {
      "properties": {
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Label",
          "type": "string"
        },
        "organization_label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Organization Label",
          "type": "string"
        },
        "compute_supported": {
          "title": "Compute Supported",
          "type": "boolean"
        },
        "uses_project_budget": {
          "title": "Uses Project Budget",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "code",
        "label",
        "organization_label",
        "compute_supported",
        "uses_project_budget"
      ],
      "title": "ProjectComputeRef",
      "type": "object"
    },
    "ProjectComputeTaskRef": {
      "properties": {
        "task_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Task Id",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "site_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "generation",
        "site_id"
      ],
      "title": "ProjectComputeTaskRef",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "project.member-task/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "requested_task_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Requested Task Id",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/ProjectComputeTaskRef"
    },
    "project": {
      "$ref": "#/$defs/ProjectComputeRef"
    },
    "membership_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Membership Id",
      "type": "string"
    },
    "username": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Username",
      "type": "string"
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "ready",
        "expired",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "result_code": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
      "title": "Result Code",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Finished At"
    },
    "compute_enabled": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Compute Enabled"
    },
    "membership_status": {
      "anyOf": [
        {
          "enum": [
            "active",
            "scheduled",
            "expired"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Membership Status"
    },
    "can_retry": {
      "title": "Can Retry",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "requested_task_id",
    "task",
    "project",
    "membership_id",
    "username",
    "status",
    "result_code",
    "finished_at",
    "compute_enabled",
    "membership_status",
    "can_retry"
  ],
  "title": "ProjectComputeTaskOut",
  "type": "object"
}
