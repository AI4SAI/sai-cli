{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nodes"
  ],
  "properties": {
    "schema_version": {
      "const": "node-interconnect-join/v1"
    },
    "nodes": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "status",
              "value"
            ],
            "properties": {
              "node": {
                "$ref": "#/$defs/hardware_record/$defs/ref"
              },
              "status": {
                "const": "recorded"
              },
              "value": {
                "$ref": "#/$defs/hardware_record"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node",
              "status",
              "reason"
            ],
            "properties": {
              "node": {
                "$ref": "#/$defs/hardware_record/$defs/ref"
              },
              "status": {
                "const": "unavailable"
              },
              "reason": {
                "enum": [
                  "not_recorded",
                  "expired",
                  "configuration_changed",
                  "allocation_dimensions_unknown",
                  "record_invalid",
                  "node_limit",
                  "size_limit",
                  "node_restarted"
                ]
              }
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "hardware_record": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "node",
        "cluster",
        "observed_at",
        "expires_at",
        "cpu_topology",
        "numa",
        "gpus",
        "links",
        "nics",
        "boot_time",
        "slurmd_start_time"
      ],
      "$defs": {
        "ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "path": {
          "type": "string",
          "pattern": "^(NV[1-9][0-9]{0,2}|PIX|PXB|PHB|NODE|SYS)$"
        },
        "cpuIds": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/hardware_record/$defs/count"
          },
          "uniqueItems": true
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        }
      },
      "properties": {
        "schema_version": {
          "const": "node.interconnect/v1"
        },
        "node": {
          "$ref": "#/$defs/hardware_record/$defs/ref"
        },
        "cluster": {
          "$ref": "#/$defs/hardware_record/$defs/ref"
        },
        "observed_at": {
          "$ref": "#/$defs/hardware_record/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/hardware_record/$defs/timestamp"
        },
        "cpu_topology": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sockets",
            "cores_per_socket",
            "threads_per_core"
          ],
          "properties": {
            "sockets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "cores_per_socket": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            },
            "threads_per_core": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65536
            }
          }
        },
        "numa": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "packages",
              "linux_cpu_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/hardware_record/$defs/count"
              },
              "packages": {
                "$ref": "#/$defs/hardware_record/$defs/cpuIds"
              },
              "linux_cpu_ids": {
                "$ref": "#/$defs/hardware_record/$defs/cpuIds"
              }
            }
          }
        },
        "gpus": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "numa",
              "cpu_ids"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "numa": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 65535
              },
              "cpu_ids": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/hardware_record/$defs/cpuIds"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "pcie_path": {
                "type": [
                  "array",
                  "null"
                ],
                "minItems": 1,
                "maxItems": 32,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^(root|bridge)-[0-9]{1,4}$"
                }
              }
            }
          }
        },
        "links": {
          "type": "array",
          "maxItems": 2016,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "kind"
            ],
            "properties": {
              "a": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "b": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "kind": {
                "$ref": "#/$defs/hardware_record/$defs/path"
              }
            }
          }
        },
        "nics": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index",
              "gpu_paths",
              "peer",
              "rate_gbps"
            ],
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              },
              "gpu_paths": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "gpu",
                    "kind"
                  ],
                  "properties": {
                    "gpu": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 63
                    },
                    "kind": {
                      "$ref": "#/$defs/hardware_record/$defs/path"
                    }
                  }
                }
              },
              "peer": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^endpoint-[0-9a-f]{24}$"
              },
              "rate_gbps": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100000
              }
            }
          }
        },
        "boot_time": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "slurmd_start_time": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "fabric_links": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "a",
              "b",
              "kind"
            ],
            "properties": {
              "a": {
                "type": "string",
                "pattern": "^endpoint-[0-9a-f]{24}$"
              },
              "b": {
                "type": "string",
                "pattern": "^endpoint-[0-9a-f]{24}$"
              },
              "kind": {
                "const": "infiniband"
              }
            }
          }
        },
        "cpu_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observed_at",
            "slurm_to_linux"
          ],
          "properties": {
            "observed_at": {
              "$ref": "#/$defs/hardware_record/$defs/timestamp"
            },
            "slurm_to_linux": {
              "$ref": "#/$defs/hardware_record/$defs/cpuIds"
            }
          }
        }
      }
    }
  }
}
