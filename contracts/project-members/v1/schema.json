{
  "$defs": {
    "ProjectComputeMember": {
      "properties": {
        "membership_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Membership Id",
          "type": "string"
        },
        "username": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Username",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "write",
            "read"
          ],
          "title": "Role",
          "type": "string"
        },
        "compute_enabled": {
          "title": "Compute Enabled",
          "type": "boolean"
        },
        "valid_from": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid From"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "membership_status": {
          "enum": [
            "active",
            "scheduled",
            "expired"
          ],
          "title": "Membership Status",
          "type": "string"
        }
      },
      "required": [
        "membership_id",
        "username",
        "role",
        "compute_enabled",
        "valid_from",
        "expires_at",
        "membership_status"
      ],
      "title": "ProjectComputeMember",
      "type": "object"
    },
    "ProjectComputeRef": {
      "properties": {
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Label",
          "type": "string"
        },
        "organization_label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Organization Label",
          "type": "string"
        },
        "compute_supported": {
          "title": "Compute Supported",
          "type": "boolean"
        },
        "uses_project_budget": {
          "title": "Uses Project Budget",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "code",
        "label",
        "organization_label",
        "compute_supported",
        "uses_project_budget"
      ],
      "title": "ProjectComputeRef",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "project.members/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "site_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Site Id",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ProjectComputeRef"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ProjectComputeMember"
      },
      "maxItems": 100,
      "title": "Items",
      "type": "array"
    },
    "has_more": {
      "title": "Has More",
      "type": "boolean"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Next Cursor"
    }
  },
  "required": [
    "schema_version",
    "site_id",
    "project",
    "items",
    "has_more",
    "next_cursor"
  ],
  "title": "ProjectComputeMembersOut",
  "type": "object"
}
