{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bounded current log bytes for an authorized managed Run",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "compute-run-log.v1"
    },
    "workspace_key": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(personal|org|project):[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "run_ref": {
      "$ref": "#/$defs/reference"
    },
    "stream": {
      "enum": [
        "stdout",
        "stderr"
      ]
    },
    "available": {
      "type": "boolean"
    },
    "content": {
      "type": "string",
      "maxLength": 65536,
      "$comment": "The UTF-8 encoding must contain at most 65536 bytes. maxLength counts code points and is only a necessary bound; consumers also enforce the byte limit. Newlines and log control characters remain data."
    },
    "cursor": {
      "type": "string",
      "pattern": "^log-(stdout|stderr)-(0|[1-9][0-9]{0,18})$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "next_cursor": {
      "type": "string",
      "pattern": "^log-(stdout|stderr)-(0|[1-9][0-9]{0,18})$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "truncated": {
      "type": "boolean"
    },
    "complete": {
      "type": "boolean"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "const": "site-agent"
        },
        "queried_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "source",
        "queried_at"
      ]
    }
  },
  "required": [
    "schema_version",
    "workspace_key",
    "site_id",
    "run_ref",
    "stream",
    "available",
    "content",
    "cursor",
    "next_cursor",
    "truncated",
    "complete",
    "observed_at",
    "freshness"
  ]
}
