{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current declared output files for an authorized managed Run",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "timestamp": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "compute-run-artifacts.v1"
    },
    "workspace_key": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^(personal|org|project):[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "run_ref": {
      "$ref": "#/$defs/reference"
    },
    "cursor": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,8})$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "complete": {
      "type": "boolean"
    },
    "observed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source": {
          "const": "site-agent"
        },
        "queried_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "source",
        "queried_at"
      ]
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "artifact_ref": {
            "$ref": "#/$defs/reference"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
            "not": {
              "pattern": "[\\\\\\x00-\\x1f\\x7f]"
            },
            "$comment": "Workspace-relative POSIX filename, not an identifier token. Consumers safely render C1 characters without changing the file locator. Sensitive path components are rejected by the existing file authorization boundary."
          },
          "relative_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$",
            "not": {
              "pattern": "[\\\\\\x00-\\x1f\\x7f]"
            },
            "$comment": "Workspace-relative POSIX filename, not an identifier token. Consumers safely render C1 characters without changing the file locator. Sensitive path components are rejected by the existing file authorization boundary."
          },
          "kind": {
            "const": "file"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807
          },
          "modified_at_ns": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "artifact_ref",
          "display_name",
          "relative_path",
          "kind",
          "size_bytes",
          "modified_at_ns"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "workspace_key",
    "site_id",
    "run_ref",
    "cursor",
    "next_cursor",
    "complete",
    "observed_at",
    "freshness",
    "items"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complete": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "minItems": 1
          },
          "next_cursor": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,8})$",
            "not": {
              "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
            }
          }
        }
      }
    }
  ]
}
