{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Current Run-bound node registration",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_ref",
    "workspace_key",
    "site_id",
    "queried_at",
    "execution",
    "placement"
  ],
  "properties": {
    "run_ref": {
      "$ref": "#/$defs/reference"
    },
    "workspace_key": {
      "type": "string",
      "minLength": 9,
      "maxLength": 128,
      "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
      }
    },
    "queried_at": {
      "$ref": "#/$defs/timestamp"
    },
    "execution": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "sluid",
            "submit_time",
            "start_time",
            "restart_count",
            "resize_time"
          ],
          "properties": {
            "sluid": {
              "type": "string",
              "pattern": "^s[0-9A-HJKMNP-TV-Z]{13}$",
              "minLength": 14,
              "maxLength": 14,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            "submit_time": {
              "$ref": "#/$defs/timestamp"
            },
            "start_time": {
              "$ref": "#/$defs/timestamp"
            },
            "restart_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "resize_time": {
              "anyOf": [
                {
                  "$ref": "#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "schema_version": {
      "const": "compute.run-placement/v1"
    },
    "placement": {
      "title": "Registered asset placement for one authorized job observation",
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "jobs.placement/v1"
        },
        "allocation": {
          "$ref": "#/$defs/allocation_snapshot"
        },
        "inventory": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "revision": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "generation": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "published_at": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                  "format": "date-time"
                },
                "expires_at": {
                  "type": "string",
                  "maxLength": 64,
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                  "format": "date-time"
                }
              },
              "required": [
                "revision",
                "generation",
                "published_at",
                "expires_at"
              ],
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "coverage": {
          "const": "allocated_nodes_only"
        },
        "nodes": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
                "not": {
                  "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                }
              },
              "status": {
                "enum": [
                  "recorded",
                  "unmapped",
                  "expired"
                ]
              },
              "registration": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "asset_ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                        "not": {
                          "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                        }
                      },
                      "incarnation_ref": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                        "not": {
                          "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                        }
                      },
                      "placement_ref": {
                        "anyOf": [
                          {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128,
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                            "not": {
                              "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                            }
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128,
                        "not": {
                          "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                        }
                      },
                      "verified_at": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                        "format": "date-time"
                      },
                      "valid_until": {
                        "type": "string",
                        "maxLength": 64,
                        "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                        "format": "date-time"
                      },
                      "rack": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                                "not": {
                                  "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                                }
                              },
                              "label": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "not": {
                                  "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                                }
                              },
                              "u_start": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                              },
                              "u_height": {
                                "type": "integer",
                                "minimum": 1,
                                "maximum": 100
                              }
                            },
                            "required": [
                              "ref",
                              "label",
                              "u_start",
                              "u_height"
                            ],
                            "additionalProperties": true
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "asset_ref",
                      "incarnation_ref",
                      "placement_ref",
                      "label",
                      "verified_at",
                      "valid_until",
                      "rack"
                    ],
                    "additionalProperties": true,
                    "allOf": [
                      {
                        "if": {
                          "properties": {
                            "rack": {
                              "type": "null"
                            }
                          }
                        },
                        "then": {
                          "properties": {
                            "placement_ref": {
                              "type": "null"
                            }
                          }
                        },
                        "else": {
                          "properties": {
                            "placement_ref": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                              "not": {
                                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                              }
                            }
                          }
                        }
                      }
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "name",
              "status",
              "registration"
            ],
            "additionalProperties": true,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "recorded"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "registration": {
                      "type": "object",
                      "properties": {
                        "asset_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                          "not": {
                            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                          }
                        },
                        "incarnation_ref": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                          "not": {
                            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                          }
                        },
                        "placement_ref": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 128,
                              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                              "not": {
                                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                              }
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "not": {
                            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                          }
                        },
                        "verified_at": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                          "format": "date-time"
                        },
                        "valid_until": {
                          "type": "string",
                          "maxLength": 64,
                          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
                          "format": "date-time"
                        },
                        "rack": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "ref": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                                  "not": {
                                    "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                                  }
                                },
                                "label": {
                                  "type": "string",
                                  "minLength": 1,
                                  "maxLength": 128,
                                  "not": {
                                    "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                                  }
                                },
                                "u_start": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                },
                                "u_height": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 100
                                }
                              },
                              "required": [
                                "ref",
                                "label",
                                "u_start",
                                "u_height"
                              ],
                              "additionalProperties": true
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "asset_ref",
                        "incarnation_ref",
                        "placement_ref",
                        "label",
                        "verified_at",
                        "valid_until",
                        "rack"
                      ],
                      "additionalProperties": true,
                      "allOf": [
                        {
                          "if": {
                            "properties": {
                              "rack": {
                                "type": "null"
                              }
                            }
                          },
                          "then": {
                            "properties": {
                              "placement_ref": {
                                "type": "null"
                              }
                            }
                          },
                          "else": {
                            "properties": {
                              "placement_ref": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 128,
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:+-]{0,127}$",
                                "not": {
                                  "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "else": {
                  "properties": {
                    "registration": {
                      "type": "null"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "allocation",
        "inventory",
        "coverage",
        "nodes"
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "job": {
      "additionalProperties": true,
      "properties": {
        "array_task_id": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "elapsed_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "gpus_per_node": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "pattern": "^[0-9]+$",
          "type": "string"
        },
        "mem_per_unit": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "nodes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "partition": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "priority": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "qos": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_or_nodelist": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_wait_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "slots": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "slurm_account": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "slurm_user": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "start_time": {
          "anyOf": [
            {
              "format": "date-time",
              "maxLength": 64,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "maxLength": 32,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "type": "string"
        },
        "state_label": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "submit_time": {
          "anyOf": [
            {
              "format": "date-time",
              "maxLength": 64,
              "minLength": 1,
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              },
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "job_id",
        "array_task_id",
        "name",
        "slurm_user",
        "slurm_account",
        "state",
        "state_label",
        "priority",
        "submit_time",
        "start_time",
        "elapsed_seconds",
        "run_wait_seconds",
        "partition",
        "qos",
        "nodes",
        "slots",
        "gpus_per_node",
        "mem_per_unit",
        "reason_or_nodelist"
      ],
      "type": "object"
    },
    "node": {
      "additionalProperties": true,
      "properties": {
        "cpus": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "memory_mib": {
          "anyOf": [
            {
              "maximum": 9223372036854775807,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        "gres": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "$ref": "#/$defs/gres"
              }
            }
          ]
        }
      },
      "required": [
        "name",
        "cpus",
        "memory_mib",
        "gres"
      ],
      "type": "object"
    },
    "gres": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "name",
        "type",
        "count",
        "indices"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$",
          "not": {
            "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
          }
        },
        "type": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,127}$",
              "not": {
                "pattern": "[\\x00-\\x1f\\x7f-\\x9f]"
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "indices": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          ]
        }
      }
    },
    "allocation_snapshot": {
      "additionalProperties": true,
      "properties": {
        "allocation": {
          "additionalProperties": true,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "allocated"
                  }
                }
              },
              "then": {
                "properties": {
                  "nodes": {
                    "minItems": 1,
                    "type": "array"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "not_allocated"
                  }
                }
              },
              "then": {
                "properties": {
                  "nodes": {
                    "maxItems": 0,
                    "type": "array"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "nodes": {
                    "type": "null"
                  }
                }
              }
            }
          ],
          "properties": {
            "nodes": {
              "anyOf": [
                {
