{
  "$defs": {
    "ProjectComputeMember": {
      "properties": {
        "membership_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Membership Id",
          "type": "string"
        },
        "username": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Username",
          "type": "string"
        },
        "role": {
          "enum": [
            "owner",
            "admin",
            "write",
            "read"
          ],
          "title": "Role",
          "type": "string"
        },
        "compute_enabled": {
          "title": "Compute Enabled",
          "type": "boolean"
        },
        "valid_from": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Valid From"
        },
        "expires_at": {
          "anyOf": [
            {
              "maxLength": 64,
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expires At"
        },
        "membership_status": {
          "enum": [
            "active",
            "scheduled",
            "expired"
          ],
          "title": "Membership Status",
          "type": "string"
        }
      },
      "required": [
        "membership_id",
        "username",
        "role",
        "compute_enabled",
        "valid_from",
        "expires_at",
        "membership_status"
      ],
      "title": "ProjectComputeMember",
      "type": "object"
    },
    "ProjectComputeRef": {
      "properties": {
        "project_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Project Id",
          "type": "string"
        },
        "code": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Code",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Label",
          "type": "string"
        },
        "organization_label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Organization Label",
          "type": "string"
        },
        "compute_supported": {
          "title": "Compute Supported",
          "type": "boolean"
        },
        "uses_project_budget": {
          "title": "Uses Project Budget",
          "type": "boolean"
        }
      },
      "required": [
        "project_id",
        "code",
        "label",
        "organization_label",
        "compute_supported",
        "uses_project_budget"
      ],
      "title": "ProjectComputeRef",
      "type": "object"
    },
    "ProjectComputeSiteState": {
      "properties": {
        "site_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Site Id",
          "type": "string"
        },
        "site_label": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$",
          "title": "Site Label",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
          "title": "Status",
          "type": "string"
        },
        "file_access": {
          "enum": [
            "none",
            "read",
            "write"
          ],
          "title": "File Access",
          "type": "string"
        },
        "compute_access": {
          "title": "Compute Access",
          "type": "boolean"
        },
        "compute_access_reason": {
          "anyOf": [
            {
              "enum": [
                "restricted",
                "restriction_pending",
                "recovery_pending",
                "failed",
                "scheduler_unconfirmed",
                "limits_pending",
                "limits_failed",
                "limits_drift",
                "submission_limit_zero"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compute Access Reason"
        },
        "task_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "task_url": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Url"
        }
      },
      "required": [
        "site_id",
        "site_label",
        "status",
        "file_access",
        "compute_access"
      ],
      "title": "ProjectComputeSiteState",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "project.member/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "site_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Site Id",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ProjectComputeRef"
    },
    "member": {
      "$ref": "#/$defs/ProjectComputeMember"
    },
    "sites": {
      "items": {
        "$ref": "#/$defs/ProjectComputeSiteState"
      },
      "maxItems": 64,
      "title": "Sites",
      "type": "array"
    },
    "enable_compute_allowed": {
      "title": "Enable Compute Allowed",
      "type": "boolean"
    },
    "unavailable_reason": {
      "anyOf": [
        {
          "enum": [
            "already_enabled",
            "permission_denied",
            "member_not_current",
            "file_editing_required",
            "compute_not_supported",
            "site_unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Unavailable Reason"
    }
  },
  "required": [
    "schema_version",
    "site_id",
    "project",
    "member",
    "sites",
    "enable_compute_allowed",
    "unavailable_reason"
  ],
  "title": "ProjectComputeMemberOut",
  "type": "object"
}
