{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authorized managed computation workspaces",
  "type": "object",
  "required": [
    "schema_version",
    "site_id",
    "queried_at",
    "items",
    "next_cursor",
    "has_more"
  ],
  "properties": {
    "schema_version": {
      "const": "compute.workspaces/v1"
    },
    "site_id": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "queried_at": {
      "type": "string",
      "maxLength": 64,
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "workspace_key",
          "label",
          "organization_label"
        ],
        "properties": {
          "workspace_key": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
          },
          "organization_label": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 9,
          "maxLength": 128,
          "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "has_more": {
      "type": "boolean"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "has_more": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "next_cursor": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "next_cursor": {
            "type": "string",
            "minLength": 9,
            "maxLength": 128,
            "pattern": "^project:[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "items": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
