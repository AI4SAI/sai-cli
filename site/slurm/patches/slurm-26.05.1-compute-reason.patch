+typedef struct {
+	const char *marker;
+	const char *description;
+	const char *warning;
+} compute_gate_reason_t;
+
+static const compute_gate_reason_t _compute_gate_reasons[] = {
+	{ "[sai.compute-gate/v1:arrears]",
+	  "Arrears",
+	  "欠费，暂不能启动 / Overdue charges; cannot start." },
+	{ "[sai.compute-gate/v1:severe_arrears]",
+	  "Severe arrears",
+	  "严重欠费，暂不能启动 / Severe arrears; cannot start." },
+	{ "[sai.compute-gate/v1:no_compute_funding]",
+	  "No compute funds",
+	  "资金不足，暂不能启动 / No available compute funding." },
+	{ "[sai.compute-gate/v1:admin_blocked]",
+	  "Admin disabled",
+	  "已被管理员限制启动 / Start blocked by administrator." },
+};
+
+static const compute_gate_reason_t *_compute_gate_reason(const char *text)
+{
+	if (!text)
+		return NULL;
+	for (size_t i = 0; i < ARRAY_SIZE(_compute_gate_reasons); i++) {
+		const compute_gate_reason_t *reason = &_compute_gate_reasons[i];
+		size_t len = strlen(reason->marker);
+
+		if (!strncmp(text, reason->marker, len) &&
+		    (!text[len] || (text[len] == ' ')))
+			return reason;
+	}
+	return NULL;
+}
+
+static bool _compute_gate_account_valid(const char *account)
+{
+	size_t len;
+
+	if (!account || !(len = strnlen(account, 129)) || (len > 128))
+		return false;
+	if (!((account[0] >= '0' && account[0] <= '9') ||
+	      (account[0] >= 'A' && account[0] <= 'Z') ||
+	      (account[0] >= 'a' && account[0] <= 'z')))
+		return false;
+	return strspn(account, "abcdefghijklmnopqrstuvwxyz"
+		      "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.+-") == len;
+}
+
+static const compute_gate_reason_t *_compute_gate_description(
+	const char *text, const char **account)
+{
+	if (!text)
+		return NULL;
+	for (size_t i = 0; i < ARRAY_SIZE(_compute_gate_reasons); i++) {
+		const compute_gate_reason_t *reason = &_compute_gate_reasons[i];
+		size_t len = strlen(reason->description);
+
+		if (strncmp(text, reason->description, len) ||
+		    strncmp(text + len, ": ", 2) ||
+		    !_compute_gate_account_valid(text + len + 2))
+			continue;
+		if (account)
+			*account = text + len + 2;
+		return reason;
+	}
+	return NULL;
+}
+
+extern void acct_policy_add_compute_gate_warning(job_record_t *job_ptr,
+						 char **message)
+{
+	const compute_gate_reason_t *reason;
+	const char *account;
+
+	if (!message || !job_ptr || !IS_JOB_PENDING(job_ptr) ||
+	    (job_ptr->state_reason != WAIT_ASSOC_GRP_JOB) ||
+	    !(reason = _compute_gate_description(job_ptr->state_desc, &account)))
+		return;
+	xstrfmtcat(*message, "%sWARNING: Account %s %s",
+		   *message ? "\n" : "", account, reason->warning);
+}
+
